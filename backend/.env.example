# ============================================================
# 企业内部私有化 AI Agent 工具调度平台 - 环境变量示例
# 复制本文件为 .env 后按需修改：cp .env.example .env
# ============================================================

# ----- 应用基础配置 -----
# 服务名称（仅展示用，可不改）
APP_NAME=企业AI Agent 工具调度平台
# API 路由前缀
API_V1_PREFIX=/api/v1
# JWT 签名密钥：生产环境务必替换为随机长字符串
SECRET_KEY=change-me-in-production-please
# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 允许跨域的前端来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- 数据库（PostgreSQL + pg_vector 扩展） -----
# 异步驱动连接串（FastAPI 使用）
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/agent_platform
# 同步驱动连接串（种子脚本 / 离线任务使用）
DB_DSN_SYNC=postgresql+psycopg2://postgres:123456@localhost:5432/agent_platform

# ----- Redis（会话缓存 / 限流 / 临时任务） -----
REDIS_URL=redis://:123456@localhost:6379/0

# ----- MinIO 对象存储（文档 / 报表 / 附件） -----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-platform
# 是否使用 HTTPS 访问 MinIO（内网一般 false）
MINIO_SECURE=False

# 通用文件工具（file_read / folder_list）沙箱根目录：仅允许访问该目录内的文件。
# 留空则默认 backend/data。可改为业务文档目录，如 D:/docs
GENERAL_FILE_BASE_DIR=

# ----- 大模型（内网私有化部署，兼容 OpenAI 接口，推荐 vLLM） -----
# ⚠️ 下面三个 *_BASE_URL 必须指向「真实的模型服务」，**不能是本项目后端自身**！
#    本项目后端默认跑在 8000 端口，若指向 localhost:8000 会返回 404。
#    演示 / 暂时没有模型服务时：把下方 MOCK_LLM=true 即可零配置运行，无需填这些地址。
# LLM 服务基础地址（指向你的 vLLM，端口别与本项目 8000 冲突），例如 http://localhost:9000/v1
LLM_BASE_URL=http://localhost:8000/v1
# 鉴权密钥（内网无鉴权可留空或 EMPTY）
LLM_API_KEY=EMPTY
# 轻量问答模型（用于简单意图识别 / 闲聊）
LLM_LIGHT_MODEL=deepseek-chat
# 复杂工具调用模型（用于 Planner / 多步编排）
LLM_HEAVY_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
# 推理模型（DeepSeek-R1 类，负责复杂多步推理）
LLM_REASONING_MODEL=deepseek-reasoner

# ----- 向量化 Embedding 模型 -----
# 本项目已内置本地 Embedding 服务（backend/embedding_service，bge-small-zh-v1.5，端口 7088）。
# 直接指向它即可开启向量召回；留空则 RAG 回退关键词检索。
# ⚠️ 同样不能是本项目后端 localhost:8000。
EMBEDDING_BASE_URL=http://localhost:7088/v1
EMBEDDING_API_KEY=EMPTY
# Embedding 模型名（需与维度匹配）
EMBEDDING_MODEL=bge-small-zh-v1.5
# Embedding 向量维度（bge-small-zh-v1.5 为 512）
EMBEDDING_DIM=512

# 重排模型（bge-reranker-v2-m3），由独立 rerank 服务暴露（backend/rerank_service）
# 直接指向本地服务即可开启精排；留空则不重排（直接返回向量/关键词召回序）。
# ⚠️ 同样不能是本项目后端 localhost:8000。
RERANK_BASE_URL=http://localhost:7089
RERANK_API_KEY=EMPTY
RERANK_MODEL=bge-reranker-v2-m3

# ----- 功能开关 -----
# 接入真实环境：三项改为 false 即走真实模型与真实工具（未配置的系统会明确报错）
# 仅演示时保持 true 即可零配置运行
MOCK_LLM=false
MOCK_TOOLS=false
# 外网检索工具（天气 / 汇率 / 公开资料等）默认关闭，防止数据外泄；管理员可在后台按需开启
EXTERNAL_TOOLS_ENABLED=false

# ========== 真实系统集成配置（填入即生效；MOCK_TOOLS=false 时未配置的系统会明确报错）==========
# 协同办公
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
DOC_BASE_URL=
DOC_TOKEN=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_USER=
MAIL_PASSWORD=

# 研发
# GitHub 代码仓库检索 / 周报（PAT 需具备 repo 读权限）
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=
SWAGGER_BASE_URL=

# 业务系统（公司自研接口地址 + 令牌）
# 默认指向 business-systems/ 下的 Spring Cloud Gateway 网关（端口 8080），
# 路径前缀分别为 /crm /hr /finance /oa，由网关路由到对应微服务。
# 接入贵司真实系统时，把 URL 改成真实网关/地址，令牌需与各业务微服务的 SERVICE_TOKEN 一致。
CRM_BASE_URL=http://localhost:8001/crm
CRM_TOKEN=biz-svc-2026-token
HR_BASE_URL=http://localhost:8080/hr
HR_TOKEN=biz-svc-2026-token
FINANCE_BASE_URL=http://localhost:8080/finance
FINANCE_TOKEN=biz-svc-2026-token
OA_BASE_URL=http://localhost:8080/oa
OA_TOKEN=biz-svc-2026-token


# 外网检索
WEATHER_API_KEY=
SEARCH_API_KEY=
WHOIS_API_KEY=
CALENDAR_BASE_URL=
EXCHANGE_RATE_API_KEY=
