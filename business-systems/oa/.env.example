# OA 仿真业务系统环境变量示例（复制为 .env 后修改）
APP_NAME=OA 仿真业务系统
PORT=8004

# 独立数据库（与 Agent 平台及其它业务系统隔离）
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/oa_db

# 共享服务令牌：Agent 调用时通过 Authorization: Bearer <token> 携带
# 必须与 Agent 的 OA_TOKEN 保持一致
SERVICE_TOKEN=biz-svc-2026-token

# 允许跨域来源（* 表示全部，生产环境建议收紧）
CORS_ORIGINS=*
